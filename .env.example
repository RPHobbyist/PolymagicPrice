# PolymagicPrice Environment Configuration
# Copy this file to .env and fill in your values
# Note: Variables must start with VITE_ to be exposed to the client

# ─── SEO & Identity ──────────────────────────────────────────────
# The base URL used for canonical tags and social sharing (og:url, og:image).
# If not set, defaults to the current browser origin (safe for forks).
# VITE_BASE_URL=https://your-domain.com

# Official branding toggle. Set to "true" only on your official hosted deployment.
# When false (default), the app behaves as a neutral open-source build.
VITE_IS_OFFICIAL=false

# ─── Vendor / Branding ──────────────────────────────────────────
# Your name and website, shown in the footer and license notice.
# VITE_VENDOR_NAME=Your Name
# VITE_VENDOR_URL=https://your-website.com

# ─── Community Links ────────────────────────────────────────────
# Override to point to your own fork or channel.
# VITE_GITHUB_URL=https://github.com/your-user/your-repo.git
# VITE_YOUTUBE_URL=https://www.youtube.com/your-channel
# VITE_DOWNLOAD_URL=https://github.com/your-user/your-repo/releases
