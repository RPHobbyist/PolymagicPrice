# ─── Dependencies ────────────────────────────────────────────────
node_modules/

# ─── Build Output ────────────────────────────────────────────────
dist/
dist-ssr/
dist-electron/
*.tsbuildinfo

# ─── Environment Variables (may contain secrets) ─────────────────
# .env.example is committed as a template for contributors
.env
.env.local
.env.*.local
.env.production
.env.staging

# ─── Electron Desktop (private, not part of the web OSS release) ─
electron/
release-packager/

# ─── Logs ────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── OS Files ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.lnk

# ─── Editor / IDE ────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace

# ─── Testing ─────────────────────────────────────────────────────
test-assets/
coverage/
*.lcov

# ─── Package Manager ────────────────────────────────────────────
*.local
.pnpm-debug.log*
.yarn/
.pnp.*

# ─── Security: Never commit these ───────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
*.cert
*.crt

# ─── Archives / Binaries (should never be in source) ────────────
*.7z
*.zip
*.tar.gz
*.rar
*.exe
*.msi
*.dmg
*.AppImage
*.snap
*.deb
*.rpm

# ─── Build Caches ───────────────────────────────────────────────
.eb-cache/
.cache/
.parcel-cache/
.turbo/
.vercel/
.netlify/

# ─── Misc ────────────────────────────────────────────────────────
*.map
